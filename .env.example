# ==============================================================================
# RECOVERAI ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and configure with your actual Razorpay Test Mode keys.
# DO NOT COMMIT ACTUAL SECRETS TO GIT REPOSITORIES.
# ==============================================================================

# Razorpay Test Mode Credentials (Obtained from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE

# Razorpay Webhook Secret (Configured in Razorpay Webhooks dashboard for HMAC SHA-256 verification)
RAZORPAY_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Gemini AI API Key (Optional: Used for LLM-enhanced recovery analysis & reasoning)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Port Configurations
RECOVERAI_BACKEND_PORT=8000
RECOVERAI_DASHBOARD_PORT=5173
AURA_STORE_BACKEND_PORT=8001
AURA_STORE_FRONTEND_PORT=5174
